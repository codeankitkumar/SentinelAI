# Docker build-context exclusions (repo-root context for the backend image).
# NOTE: ml/models is intentionally KEPT so the backend image ships a trained model.
.git
.gitignore
**/__pycache__/
**/*.pyc
**/*.pyo
**/.venv
**/venv
node_modules
**/node_modules
.vscode
.idea
*.log
.env
.env.local
captures/
ml/datasets/*.csv
backend/ml/models
dist

# Windows
Thumbs.db
.DS_Store