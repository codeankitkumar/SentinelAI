# ============================================================================
# SentinelAI Environment Template
# Copy to .env and fill in values. NEVER commit the real .env.
# ============================================================================

# --- General ---
APP_NAME=SentinelAI
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (PostgreSQL) ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret
POSTGRES_DB=sentinelai
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sentinel:sentinel_secret@db:5432/sentinelai

# --- Security ---
# Cost factor for bcrypt password hashing
BCRYPT_ROUNDS=12

# --- Redis (optional, for rate limiting / pub-sub) ---
REDIS_URL=redis://redis:6379/0

# --- Monitoring Engine ---
# Set to true only inside an authorized, isolated lab with privileged access.
NETWORK_MONITOR_ENABLED=false
# Live capture interface (e.g. eth0, wlan0). Use 'any' for all.
MONITOR_INTERFACE=any
# Only capture traffic destined for / originating from these CIDRs when set.
MONITOR_ALLOWED_CIDRS=
# Idle time (seconds) before an inactive flow is considered finished.
FLOW_IDLE_TIMEOUT=60

# --- ML Model ---
ML_MODEL_PATH=ml/models/sentinel_model.joblib
ML_SCALER_PATH=ml/models/scaler.joblib

# --- Sample/Seed mode ---
# When true, the API generates synthetic network events so the dashboard is
# usable without a live capture environment.
SEED_DEMO_DATA=true
SEED_DEMO_EVENTS=2000

# --- Threat Intelligence ---
# Leave empty to disable. Respect API rate limits (see docs).
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# --- AI Assistant ---
# Choose a provider: "rules" (offline rule-based) or "openai".
ASSISTANT_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- CORS (frontend origin) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000/api